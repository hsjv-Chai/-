{
  "name": "melon-community",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/local-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin": "node scripts/create-admin.mjs",
    "test:integration": "node tests/integration/test-integration.mjs",
    "build:ecs": "next build --webpack",
    "start:ecs": "next start",
    "init:ecs": "node scripts/init-ecs.mjs",
    "test:ecs": "MELON_STORAGE=node node tests/integration/test-integration.mjs",
    "test:games": "node --experimental-strip-types --test tests/unit/test-games.mts",
    "test:single-room": "node --experimental-strip-types tests/integration/test-single-room-api.mts",
    "test:garden": "node --experimental-strip-types --test tests/unit/test-garden.mts",
    "test:garden-api": "node --experimental-strip-types tests/integration/test-garden-api.mts",
    "test:boundaries": "node --test tests/unit/test-module-boundaries.mjs",
    "test:api-routing": "node tests/integration/test-api-routing.mjs",
    "test:games-api": "node --experimental-strip-types tests/integration/test-games-api.mts",
    "test:root-domain": "node tests/integration/test-root-domain.mjs",
    "test:accounts": "node --experimental-strip-types --test tests/unit/test-registration-ip.mts",
    "test:accounts-api": "node --experimental-strip-types tests/integration/test-accounts-api.mts",
    "test:accounts-persistence": "node --experimental-strip-types tests/integration/test-accounts-persistence.mts",
    "test:email": "node --import ./tests/helpers/ts-alias-loader.mjs --experimental-strip-types --test tests/unit/test-email.mts",
    "test:email-api": "node --experimental-strip-types tests/integration/test-email-api.mts",
    "mail:prepare": "node scripts/prepare-mail-config.mjs",
    "test:email-production": "node tests/integration/test-email-production.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
